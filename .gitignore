# Hide files auto-generated by react router
.react-router/

# Horizon theme backup
/theme-horizon-backup/

# ============================================
# Shrine Theme — track config + customizations
# ============================================

# Ignore everything inside theme/
/theme/*

# Track: config (global theme settings — colors, fonts, header, cart, etc.)
!/theme/config/
/theme/config/*
!/theme/config/settings_data.json

# Track: all templates (page definitions + section content settings)
!/theme/templates/

# Track: layout
!/theme/layout/
/theme/layout/*
!/theme/layout/theme.liquid

# Track: section group JSON files (header/footer config) + modified core files
!/theme/sections/
/theme/sections/*
!/theme/sections/header-group.json
!/theme/sections/footer-group.json
!/theme/sections/main-product.liquid

# Track: modified snippets (Liquid syntax fix)
!/theme/snippets/
/theme/snippets/*
!/theme/snippets/product-media-gallery.liquid
