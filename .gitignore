node_modules

# macOS
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*


/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/

# Ignore everything inside theme/
/theme/*

# Un-ignore sections, templates, snippets, assets and config directories so Git scans them
!/theme/sections/
!/theme/templates/
!/theme/snippets/
!/theme/assets/
!/theme/layout
!/theme/config

# Ignore all other files inside those directories...
/theme/sections/*
/theme/templates/*
/theme/snippets/*
/theme/assets/*
/theme/layout/*
/theme/config/*

# ...EXCEPT our custom LP files!
!/theme/sections/lp-longform-top.liquid
!/theme/sections/lp-longform-bottom.liquid
!/theme/sections/lp-buy-box.liquid
!/theme/sections/lp-home.liquid
!/theme/sections/lp-contact.liquid
!/theme/sections/header.liquid
!/theme/sections/header-group.json
!/theme/sections/announcement-bar.liquid
!/theme/sections/footer.liquid
!/theme/sections/footer-group.json
!/theme/sections/main-404.liquid
!/theme/sections/main-cart-items.liquid
!/theme/snippets/lp-brand-vars.liquid
!/theme/snippets/cart-drawer.liquid
!/theme/templates/page.lp-longform.json
!/theme/layout/theme.liquid
!/theme/templates/index.json
!/theme/templates/page.contact.json
!/theme/config/settings_schema.json
!/theme/config/settings_data.json
!/theme/assets/component-cart-items.css

# Now also ignore our local backups
/theme-horizon-backup/
/theme-pre-dawn-backup/
/theme-dawn-backup/