# Un-ignore sections and templates directories so Git scans them
!/theme/sections/
!/theme/templates/
!/theme/layout

# Ignore all other files inside those directories...
/theme/sections/*
/theme/templates/*
/theme/layout/*

# ...EXCEPT our custom Tibella files!
!/theme/sections/tibella-longform.liquid
!/theme/sections/tibella-longform-top.liquid
!/theme/sections/tibella-longform-bottom.liquid
!/theme/sections/tibella-home.liquid
!/theme/templates/page.tibella-longform.json
!/theme/layout/theme.liquid
!/theme/templates/index.json