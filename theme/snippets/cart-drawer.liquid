    font-size: 1.2rem;
    letter-spacing: 0.03em;
    color: rgba(var(--color-foreground), 0.55);
  }
  .bb-trust-icon {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }
</style>

<script>
function bbClearCart() {
  var drawer = document.getElementById('CartDrawer');
  if (!drawer) return;
  drawer.classList.add('bb-cart-clearing');

  fetch('/cart/clear.js', { method: 'POST' })
    .then(function() {
      return fetch('/?sections=cart-drawer,cart-icon-bubble');
    })
    .then(function(r) { return r.json(); })
    .then(function(sections) {
      var parser = new DOMParser();

      var drawerDoc = parser.parseFromString(sections['cart-drawer'], 'text/html');
      var newDrawer = drawerDoc.querySelector('#CartDrawer');
      if (newDrawer) {
        drawer.innerHTML = newDrawer.innerHTML;
      }

      var bubbleDoc = parser.parseFromString(sections['cart-icon-bubble'], 'text/html');
      var newBubble = bubbleDoc.querySelector('.shopify-section');
      var oldBubble = document.getElementById('cart-icon-bubble');
      if (newBubble && oldBubble) {
        oldBubble.innerHTML = newBubble.innerHTML;
      }

      drawer.classList.remove('bb-cart-clearing');

      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) cartDrawer.classList.add('is-empty');
    })
    .catch(function() {
      drawer.classList.remove('bb-cart-clearing');
    });
}

// Cart reservation timer (5 min, persists via sessionStorage)
(function() {
  var DURATION = 300;
  var timerInterval = null;

  function getRemaining() {
    var start = sessionStorage.getItem('bb_cart_timer_start');
    if (!start) return -1;
    var elapsed = Math.floor((Date.now() - parseInt(start, 10)) / 1000);
    return Math.max(0, DURATION - elapsed);
  }

  function formatTime(s) {
    var m = Math.floor(s / 60);
    var sec = s % 60;
    return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
  }

  function updateDisplay() {
    var el = document.getElementById('bb-cart-timer');
    if (!el) return;
    var remaining = getRemaining();
    if (remaining < 0) return;
    el.textContent = formatTime(remaining);
    if (remaining <= 60) {
      el.style.color = '#c62828';
    }
    if (remaining <= 0) {
      clearInterval(timerInterval);
      sessionStorage.removeItem('bb_cart_timer_start');
      fetch('/cart/clear.js', { method: 'POST' }).then(function() {
        window.location.reload();
      });
    }
  }

  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    if (!sessionStorage.getItem('bb_cart_timer_start')) {
      sessionStorage.setItem('bb_cart_timer_start', Date.now().toString());
    }
    updateDisplay();
    timerInterval = setInterval(updateDisplay, 1000);
  }

  var observer = new MutationObserver(function() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && drawer.classList.contains('active') && document.getElementById('bb-cart-timer')) {
      startTimer();
    } else if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  });
  var drawerEl = document.querySelector('cart-drawer');
  if (drawerEl) {
    observer.observe(drawerEl, { attributes: true, attributeFilter: ['class'] });
  }

  // Reset timer when cart is cleared
  var origClear = window.bbClearCart;
  if (origClear) {
    window.bbClearCart = function() {
      sessionStorage.removeItem('bb_cart_timer_start');
      origClear();
    };
  }
})();

// Close cart drawer when clicking outside the panel
(function() {
  var el = document.querySelector('cart-drawer');
  if (el) {
    el.addEventListener('click', function(e) {
      if (!e.target.closest('.drawer__inner') && !e.target.closest('.drawer__inner-empty')) {
        this.close();
      }
    });
  }
})();

// Apply discount code via /discount/CODE endpoint
function bbApplyDiscount() {
  var input = document.getElementById('bb-discount-input');
  var msg = document.getElementById('bb-discount-msg');
  if (!input || !msg) return;
  var code = input.value.trim();
  if (!code) {
    msg.textContent = 'Please enter a discount code';
    msg.className = 'bb-discount-msg error';
    return;
  }
  msg.textContent = 'Applying...';
  msg.className = 'bb-discount-msg';
  fetch('/discount/' + encodeURIComponent(code), { method: 'GET', redirect: 'follow' })
    .then(function() {
      return fetch('/cart.js').then(function(r) { return r.json(); });
    })
    .then(function(cart) {
      var found = cart.cart_level_discount_applications && cart.cart_level_discount_applications.some(function(d) {
        return d.title.toLowerCase() === code.toLowerCase();
      });
      if (!found) {
        found = cart.items && cart.items.some(function(item) {
          return item.line_level_discount_allocations && item.line_level_discount_allocations.some(function(d) {
            return d.discount_application && d.discount_application.title.toLowerCase() === code.toLowerCase();
          });
        });
      }
      return fetch('/?sections=cart-drawer,cart-icon-bubble')
        .then(function(r) { return r.json(); })
        .then(function(sections) {
          var drawer = document.getElementById('CartDrawer');
          var parser = new DOMParser();
          var drawerDoc = parser.parseFromString(sections['cart-drawer'], 'text/html');
          var newDrawer = drawerDoc.querySelector('#CartDrawer');
          if (newDrawer && drawer) drawer.innerHTML = newDrawer.innerHTML;
          var bubbleDoc = parser.parseFromString(sections['cart-icon-bubble'], 'text/html');
          var newBubble = bubbleDoc.querySelector('.shopify-section');
          var oldBubble = document.getElementById('cart-icon-bubble');
          if (newBubble && oldBubble) oldBubble.innerHTML = newBubble.innerHTML;
          msg = document.getElementById('bb-discount-msg');
          if (msg) {
            if (found) {
              msg.textContent = 'Discount applied!';
              msg.className = 'bb-discount-msg success';
            } else {
              msg.textContent = 'Invalid discount code';
              msg.className = 'bb-discount-msg error';
            }
          }
        });
    })
    .catch(function() {
      msg = document.getElementById('bb-discount-msg');
      if (msg) {
        msg.textContent = 'Could not apply discount';
        msg.className = 'bb-discount-msg error';
      }
    });
}

// Safeguard: strip loading state whenever the drawer renders with items
new MutationObserver(function() {
  var drawer = document.getElementById('CartDrawer');
  if (drawer && drawer.classList.contains('bb-cart-clearing') && drawer.querySelector('.cart-item')) {
    drawer.classList.remove('bb-cart-clearing');
  }
}).observe(document.getElementById('CartDrawer'), { childList: true, subtree: true });
</script>
