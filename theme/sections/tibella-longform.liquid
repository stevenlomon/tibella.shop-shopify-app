<script>
/* Pricing tab selector */
function tibSelectTab(el, price) {
  document.querySelectorAll('.tib-pricing-tab').forEach(function(t) { t.classList.remove('active'); });
  el.classList.add('active');
}

/* Buy box accordion */
function tibToggleAcc(trigger) {
  var body = trigger.nextElementSibling;
  var isOpen = trigger.classList.contains('open');
  trigger.classList.toggle('open');
  body.style.maxHeight = isOpen ? '0' : body.scrollHeight + 'px';
}

/* FAQ accordion */
function tibToggleFaq(trigger) {
  var body = trigger.nextElementSibling;
  var isOpen = trigger.classList.contains('open');
  trigger.classList.toggle('open');
  body.style.maxHeight = isOpen ? '0' : body.scrollHeight + 'px';
}
</script>

