<script>
  function addTibellaToCart() {
    const btn = document.getElementById('add-to-cart-btn');
    btn.innerText = 'Redirecting...';
    btn.disabled = true;

    const selectedRadio = document.querySelector('input[name="pack"]:checked');
    const variantId = selectedRadio ? selectedRadio.value : {{ massager.variants.first.id | default: 0 }};

    const fallbackCheckoutUrl = `/cart/${variantId}:1`;

    const safetyTimer = setTimeout(() => {
      console.warn('AJAX timed out. Executing direct permalink fallback...');
      window.location.href = fallbackCheckoutUrl;
    }, 3500);

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: parseInt(variantId),
          quantity: 1
        }]
      })
    })
    .then(res => {
      if (!res.ok) throw new Error('Cart API network error');
      return res.json();
    })
    .then(data => {
      clearTimeout(safetyTimer);
      window.location.href = '/checkout';
    })
    .catch(err => {
      console.error('AJAX failed, executing permalink fallback:', err);
      clearTimeout(safetyTimer);
      window.location.href = fallbackCheckoutUrl;
    });
  }
</script>

