<script>
  function addTibellaToCart() {
    const btn = document.getElementById('add-to-cart-btn');
    btn.innerText = 'Redirecting...';
    btn.disabled = true;

    const variantId = {{ massager.variants.first.id | default: 0 }};

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1
        }]
      })
    })
    .then(res => res.json())
    .then(data => {
      window.location.href = '/checkout';
    })
    .catch(err => {
      console.error('Cart add error:', err);
      btn.disabled = false;
      btn.innerText = 'ADD TO CART LOREM IPSUM';
    });
  }
</script>

