{% comment %}
  Tibella Longform Landing Page
  Built from first principles. Blueprint: knowledge/tibella-blueprint.md
  Belief chain = section structure. Narrative arc, not listicle.
  All clinical claims follow CAN/CANNOT say guardrails from Mechanism Doc.
{% endcomment %}

{% assign product = all_products['ankle-support-ems-massager-with-remote-control'] %}

<style>
/* ═══ DESIGN TOKENS ═══ */
:root {
  --black: #18181A;
  --gray: #666666;
  --gray-light: #999999;
  --cream: #F4EEE6;
  --beige: #DDD0C2;
  --gold: #D1AE5B;
  --gold-hover: #C49D48;
  --white: #FFFFFF;
  --white-off: #FAFAF8;

  --font-display: Georgia, 'Times New Roman', 'Palatino Linotype', serif;
  --font-body: -apple-system, 'Segoe UI', system-ui, sans-serif;

  --fs-xs: 0.75rem;
  --fs-sm: 0.875rem;
  --fs-base: 1rem;
  --fs-md: 1.125rem;
  --fs-lg: 1.25rem;
  --fs-xl: 1.5rem;
  --fs-2xl: 1.875rem;
  --fs-3xl: 2.25rem;
  --fs-4xl: 2.75rem;

  --max-w: 1120px;
  --px: clamp(20px, 5vw, 64px);
}

/* ═══ RESET ═══ */
.tib *, .tib *::before, .tib *::after { box-sizing: border-box; margin: 0; padding: 0; }
.tib {
  font-family: var(--font-body);
  color: var(--gray);
  line-height: 1.6;
  font-size: var(--fs-base);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
.tib img { max-width: 100%; height: auto; display: block; }
.tib a { text-decoration: none; color: inherit; }
.tib button { border: none; background: none; cursor: pointer; font: inherit; }
.tib ul, .tib ol { list-style: none; }
.tib h1, .tib h2, .tib h3, .tib h4 {
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--black);
  line-height: 1.2;
  text-wrap: balance;
}
.tib-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding-left: var(--px);
  padding-right: var(--px);
}

/* ═══ PILL BUTTON ═══ */
.tib-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--gold);
  color: var(--white);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--fs-base);
  padding: 16px 40px;
  border-radius: 100px;
  letter-spacing: 0.04em;
  transition: background 0.25s, transform 0.2s, box-shadow 0.25s;
  cursor: pointer;
}
.tib-btn:hover {
  background: var(--gold-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 20px rgba(209, 174, 91, 0.3);
}
.tib-btn-lg {
  width: 100%;
  max-width: 400px;
  padding: 18px 40px;
  font-size: var(--fs-md);
}
.tib-btn-outline {
  background: transparent;
  color: var(--gold);
  border: 2px solid var(--gold);
}
.tib-btn-outline:hover {
  background: var(--gold);
  color: var(--white);
}

/* ═══ SECTION SPACING ═══ */
.tib-section { padding: 72px 0; }
.tib-section-sm { padding: 48px 0; }
@media (max-width: 768px) {
  .tib-section { padding: 48px 0; }
  .tib-section-sm { padding: 32px 0; }
}

/* ═══ 1. HERO ═══ */
.tib-hero {
  background: var(--white);
  padding: 64px 0 72px;
}
.tib-hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 48px;
  align-items: center;
}
.tib-hero-eyebrow {
  font-family: var(--font-body);
  font-size: var(--fs-sm);
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.tib-hero h1 {
  font-size: var(--fs-4xl);
  margin-bottom: 20px;
  font-style: italic;
}
.tib-hero-sub {
  font-size: var(--fs-md);
  line-height: 1.65;
  color: var(--gray);
  margin-bottom: 32px;
  max-width: 520px;
}
.tib-hero-image {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tib-hero-image img,
.tib-hero-image .tib-img-placeholder {
  width: 100%;
  max-width: 460px;
  border-radius: 16px;
}
.tib-img-placeholder {
  aspect-ratio: 1;
  background: linear-gradient(145deg, var(--cream), var(--beige));
  display: flex;
  align-items: center;
  justify-content: center;
}
.tib-img-placeholder svg {
  width: 80px;
  height: 80px;
  color: var(--black);
  opacity: 0.08;
}
@media (max-width: 768px) {
  .tib-hero { padding: 40px 0 48px; }
  .tib-hero-grid { grid-template-columns: 1fr; gap: 32px; }
  .tib-hero h1 { font-size: var(--fs-3xl); }
  .tib-hero-image { order: -1; }
}

/* ═══ 2. CREDIBILITY BAR ═══ */
.tib-cred-bar {
  background: var(--black);
  padding: 22px 0;
  overflow: hidden;
}
.tib-cred-items {
  display: flex;
  justify-content: center;
  gap: 48px;
  flex-wrap: wrap;
}
.tib-cred-item {
  display: flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
}
.tib-cred-item svg {
  width: 20px;
  height: 20px;
  color: var(--gold);
  flex-shrink: 0;
}
.tib-cred-item span {
  color: rgba(244, 238, 230, 0.85);
  font-size: var(--fs-sm);
  font-weight: 600;
  letter-spacing: 0.02em;
}
@media (max-width: 768px) {
  .tib-cred-items { gap: 24px 32px; justify-content: center; }
}

/* ═══ 3. VALIDATION ═══ */
.tib-validation {
  background: var(--cream);
}
.tib-validation h2 {
  font-size: var(--fs-3xl);
  text-align: center;
  margin-bottom: 16px;
}
.tib-validation-sub {
  text-align: center;
  font-size: var(--fs-md);
  color: var(--gray);
  max-width: 640px;
  margin: 0 auto 48px;
  line-height: 1.65;
}
.tib-failed-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 40px;
}
.tib-failed-card {
  background: var(--white);
  border-radius: 12px;
  padding: 28px 24px;
  border: 1px solid rgba(24, 24, 26, 0.06);
}
.tib-failed-card-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(209, 174, 91, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.tib-failed-card-icon svg {
  width: 22px;
  height: 22px;
  color: var(--gold);
}
.tib-failed-card h3 {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  color: var(--black);
  margin-bottom: 4px;
}
.tib-failed-card .tib-targets {
  font-size: var(--fs-sm);
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 10px;
}
.tib-failed-card p {
  font-size: var(--fs-sm);
  line-height: 1.6;
  color: var(--gray);
}
.tib-voc-quote {
  background: var(--white);
  border-left: 3px solid var(--gold);
  border-radius: 0 12px 12px 0;
  padding: 24px 28px;
  margin-bottom: 16px;
}
.tib-voc-quote p {
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--fs-md);
  color: var(--black);
  line-height: 1.55;
}
.tib-voc-quote cite {
  display: block;
  margin-top: 8px;
  font-style: normal;
  font-family: var(--font-body);
  font-size: var(--fs-sm);
  color: var(--gray-light);
}
@media (max-width: 768px) {
  .tib-failed-grid { grid-template-columns: 1fr; }
  .tib-validation h2 { font-size: var(--fs-2xl); }
}

/* ═══ 4. REFRAME ═══ */
.tib-reframe {
  background: var(--white);
}
.tib-reframe h2 {
  font-size: var(--fs-3xl);
  text-align: center;
  margin-bottom: 12px;
}
.tib-reframe-metaphor {
  text-align: center;
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--fs-lg);
  color: var(--gray);
  max-width: 600px;
  margin: 0 auto 48px;
  line-height: 1.5;
}
.tib-reframe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.tib-reframe-content h3 {
  font-size: var(--fs-xl);
  margin-bottom: 16px;
}
.tib-reframe-content p {
  font-size: var(--fs-base);
  line-height: 1.7;
  margin-bottom: 16px;
}
.tib-reframe-visual {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tib-nerve-diagram {
  width: 100%;
  max-width: 400px;
  aspect-ratio: 3/4;
  background: var(--cream);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px;
  gap: 24px;
}
.tib-nerve-step {
  text-align: center;
}
.tib-nerve-step .tib-nerve-label {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--black);
  margin-bottom: 4px;
}
.tib-nerve-step .tib-nerve-desc {
  font-size: var(--fs-xs);
  color: var(--gray);
}
.tib-nerve-arrow {
  width: 2px;
  height: 28px;
  background: var(--gold);
  position: relative;
}
.tib-nerve-arrow::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  border-left: 5px solid transparent;
  border-right: 5px solid transparent;
  border-top: 6px solid var(--gold);
}

/* Wrong Layer Table */
.tib-wrong-layer {
  margin-top: 48px;
}
.tib-wrong-layer h3 {
  font-size: var(--fs-xl);
  text-align: center;
  margin-bottom: 24px;
}
.tib-layer-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(24, 24, 26, 0.08);
}
.tib-layer-table thead th {
  background: var(--black);
  color: var(--cream);
  font-family: var(--font-body);
  font-weight: 700;
  font-size: var(--fs-sm);
  padding: 14px 20px;
  text-align: left;
  letter-spacing: 0.03em;
}
.tib-layer-table tbody td {
  padding: 16px 20px;
  font-size: var(--fs-sm);
  line-height: 1.55;
  border-bottom: 1px solid rgba(24, 24, 26, 0.06);
  vertical-align: top;
}
.tib-layer-table tbody tr:last-child td { border-bottom: none; }
.tib-layer-table tbody tr:nth-child(even) td { background: var(--white-off); }
.tib-layer-table tbody td:first-child {
  font-weight: 700;
  color: var(--black);
}
.tib-layer-table tbody td:last-child {
  color: var(--gray);
}
.tib-layer-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
@media (max-width: 768px) {
  .tib-reframe-grid { grid-template-columns: 1fr; }
  .tib-reframe h2 { font-size: var(--fs-2xl); }
}

/* ═══ 5. MECHANISM ═══ */
.tib-mechanism {
  background: var(--beige);
}
.tib-mechanism h2 {
  font-size: var(--fs-3xl);
  text-align: center;
  margin-bottom: 16px;
}
.tib-mechanism-sub {
  text-align: center;
  font-size: var(--fs-md);
  color: var(--gray);
  max-width: 640px;
  margin: 0 auto 48px;
  line-height: 1.65;
}
.tib-mechanism-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
.tib-mechanism-content p {
  font-size: var(--fs-base);
  line-height: 1.7;
  margin-bottom: 16px;
}
.tib-mechanism-stat {
  background: var(--white);
  border-radius: 12px;
  padding: 24px;
  margin-top: 20px;
}
.tib-mechanism-stat .tib-stat-number {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-3xl);
  color: var(--gold);
  margin-bottom: 4px;
}
.tib-mechanism-stat .tib-stat-label {
  font-size: var(--fs-sm);
  color: var(--gray);
  line-height: 1.5;
}
.tib-mechanism-stat .tib-stat-source {
  font-size: var(--fs-xs);
  color: var(--gray-light);
  margin-top: 8px;
  font-style: italic;
}
@media (max-width: 768px) {
  .tib-mechanism-grid { grid-template-columns: 1fr; }
  .tib-mechanism h2 { font-size: var(--fs-2xl); }
}

/* ═══ 6. CLINIC TO HOME ═══ */
.tib-clinic-home {
  background: var(--white);
}
.tib-clinic-home h2 {
  font-size: var(--fs-3xl);
  text-align: center;
  margin-bottom: 16px;
}
.tib-clinic-home-sub {
  text-align: center;
  font-size: var(--fs-md);
  color: var(--gray);
  max-width: 640px;
  margin: 0 auto 40px;
  line-height: 1.65;
}
.tib-compare-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(24, 24, 26, 0.08);
  margin-bottom: 48px;
}
.tib-compare-table thead th {
  padding: 16px 24px;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-base);
  text-align: left;
}
.tib-compare-table thead th:first-child { background: var(--white-off); color: var(--gray); }
.tib-compare-table thead th:nth-child(2) { background: var(--white-off); color: var(--black); }
.tib-compare-table thead th:nth-child(3) {
  background: var(--gold);
  color: var(--white);
}
.tib-compare-table tbody td {
  padding: 14px 24px;
  font-size: var(--fs-sm);
  line-height: 1.55;
  border-bottom: 1px solid rgba(24, 24, 26, 0.06);
  vertical-align: top;
}
.tib-compare-table tbody td:first-child {
  font-weight: 700;
  color: var(--black);
  background: var(--white-off);
}
.tib-compare-table tbody td:nth-child(3) {
  background: rgba(209, 174, 91, 0.06);
}
.tib-compare-table tbody tr:last-child td { border-bottom: none; }

/* Product intro */
.tib-product-intro {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 48px;
  align-items: center;
}
.tib-product-intro h3 {
  font-size: var(--fs-2xl);
  margin-bottom: 16px;
}
.tib-product-intro p {
  font-size: var(--fs-base);
  line-height: 1.7;
  margin-bottom: 16px;
}
.tib-how-works {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 24px;
}
.tib-how-step {
  text-align: center;
  padding: 20px 16px;
  background: var(--cream);
  border-radius: 12px;
}
.tib-how-step-num {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-2xl);
  color: var(--gold);
  margin-bottom: 4px;
}
.tib-how-step-label {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--black);
  margin-bottom: 4px;
}
.tib-how-step-desc {
  font-size: var(--fs-xs);
  color: var(--gray);
}
@media (max-width: 768px) {
  .tib-product-intro { grid-template-columns: 1fr; }
  .tib-how-works { grid-template-columns: 1fr; }
  .tib-clinic-home h2 { font-size: var(--fs-2xl); }
}

/* ═══ 7. EVIDENCE ═══ */
.tib-evidence {
  background: var(--white);
}
.tib-evidence h2 {
  font-size: var(--fs-3xl);
  text-align: center;
  margin-bottom: 48px;
}
.tib-evidence-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}
.tib-evidence-col h3 {
  font-size: var(--fs-lg);
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--gold);
}
.tib-study-item {
  margin-bottom: 20px;
}
.tib-study-item .tib-study-name {
  font-weight: 700;
  font-size: var(--fs-sm);
  color: var(--black);
  margin-bottom: 4px;
}
.tib-study-item .tib-study-detail {
  font-size: var(--fs-sm);
  color: var(--gray);
  line-height: 1.55;
}
.tib-drug-stat {
  background: var(--cream);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 16px;
}
.tib-drug-stat .tib-stat-number {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-2xl);
  color: var(--black);
}
.tib-drug-stat .tib-stat-label {
  font-size: var(--fs-sm);
  color: var(--gray);
  line-height: 1.5;
  margin-top: 4px;
}
.tib-drug-stat .tib-stat-source {
  font-size: var(--fs-xs);
  color: var(--gray-light);
  margin-top: 6px;
  font-style: italic;
}
@media (max-width: 768px) {
  .tib-evidence-grid { grid-template-columns: 1fr; }
  .tib-evidence h2 { font-size: var(--fs-2xl); }
}

/* ═══ 8. BUY BOX ═══ */
.tib-buybox {
  background: var(--cream);
}
.tib-buybox-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 48px;
  align-items: start;
}
.tib-buybox-image .tib-img-placeholder {
  aspect-ratio: 1;
  border-radius: 16px;
}
.tib-buybox-content h2 {
  font-size: var(--fs-2xl);
  margin-bottom: 8px;
  text-align: left;
}
.tib-buybox-desc {
  font-size: var(--fs-base);
  color: var(--gray);
  line-height: 1.65;
  margin-bottom: 20px;
}
.tib-buybox-checks {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 24px;
}
.tib-buybox-check {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-sm);
  color: var(--black);
  font-weight: 500;
}
.tib-buybox-check svg {
  width: 18px;
  height: 18px;
  color: var(--gold);
  flex-shrink: 0;
}

/* Pricing Tabs */
.tib-pricing-label {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-md);
  color: var(--black);
  margin-bottom: 12px;
}
.tib-pricing-tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.tib-pricing-tab {
  flex: 1;
  border: 2px solid rgba(24, 24, 26, 0.12);
  border-radius: 12px;
  padding: 16px 12px;
  cursor: pointer;
  text-align: center;
  transition: all 0.2s;
  position: relative;
  background: var(--white);
}
.tib-pricing-tab.active {
  border-color: var(--gold);
  background: rgba(209, 174, 91, 0.04);
}
.tib-pricing-tab:hover { border-color: var(--gold); }
.tib-tab-badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gold);
  color: var(--white);
  font-size: 10px;
  font-weight: 700;
  padding: 2px 12px;
  border-radius: 4px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}
.tib-tab-title {
  font-weight: 700;
  font-size: var(--fs-base);
  color: var(--black);
  margin-bottom: 2px;
}
.tib-tab-price {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-lg);
  color: var(--black);
}
.tib-tab-unit {
  font-size: var(--fs-xs);
  color: var(--gray);
}
.tib-tab-savings {
  font-size: var(--fs-xs);
  color: var(--gold);
  font-weight: 700;
  margin-top: 2px;
}
.tib-trust-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 20px;
}
.tib-trust-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-sm);
  color: var(--gray);
}
.tib-trust-item svg {
  width: 16px;
  height: 16px;
  color: var(--gold);
  flex-shrink: 0;
}

/* Buy box accordion */
.tib-bb-accordion { border-top: 1px solid rgba(24, 24, 26, 0.1); margin-top: 24px; }
.tib-bb-acc-item { border-bottom: 1px solid rgba(24, 24, 26, 0.1); }
.tib-bb-acc-trigger {
  width: 100%;
  display: flex;
