{% comment %}
  Tibella Long-Form Sales Page Section
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css">

{% assign massager = all_products['ankle-support-ems-massager-with-remote-control'] %}

<div class="min-h-screen bg-slate-50 py-8 font-sans text-slate-800">
  
  <!-- HERO HEADER -->
  <header class="w-full bg-amber-50/60 border-b border-amber-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block bg-amber-600 text-white text-xs md:text-sm font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
        OVERACTIVE BLADDER & NOCTURIA BREAKTHROUGH
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 leading-tight mb-6">
        The "Ankle-to-Bladder" Signal: How 32,000+ Menopausal Women Are Quieting Misfiring Bladder Nerves from Home
      </h1>
      <p class="text-lg sm:text-xl text-slate-700 leading-relaxed mb-8 max-w-3xl mx-auto">
        If you go from <span class="font-semibold text-amber-900">"I don't have to pee"</span> to <span class="font-semibold text-amber-900">"I'm peeing"</span> in about 12 seconds—or if your bladder completely gives up when you pull into your driveway—your bladder isn't broken. It's getting bad instructions from a misfiring nerve.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-left border-t border-amber-200/60 pt-6">
        <div class="flex items-center space-x-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span class="text-sm text-slate-700">20+ Yrs Urology Science</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span class="text-sm text-slate-700">100% Drug-Free & Safe</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span class="text-sm text-slate-700">30 Min/Day While Relaxing</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span class="text-sm text-slate-700">90-Day Money-Back Trial</span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    
    <!-- BELIEF SHIFT #1 -->
    <section class="my-10 p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-sm">
      <div class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-1">
        Belief Shift #1
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">
        The 'Latchkey Bladder' Trap Is Real (And It Isn't 'Just Aging')
      </h2>

      <blockquote class="p-4 mb-6 border-l-4 border-amber-500 bg-amber-50/60 rounded-r-lg italic text-slate-800">
        "I can hold it for 45 minutes... but the second I pull into my driveway, my bladder just completely gives up."
        <cite class="block font-semibold not-italic text-sm text-slate-600 mt-2">— r/Menopause</cite>
      </blockquote>

      <p class="text-slate-700 leading-relaxed">
        If you find yourself mapping every single public bathroom before leaving the house, you are not alone. Most doctors will tell you this is "just a normal part of aging." They are wrong.
      </p>
    </section>

    <!-- OFFER SELECTOR COMPONENT -->
    <div id="tibella-offer-root" class="max-w-xl mx-auto p-6 bg-white border-2 border-amber-500 rounded-3xl shadow-xl my-12">
      <div class="text-center mb-6">
        <h3 class="text-2xl font-bold text-slate-900">Select Your Tibella Package</h3>
        <p class="text-sm text-slate-600 mt-1">Includes 90-Day Money-Back Guarantee + Free US Shipping</p>
      </div>

      <div class="space-y-4 mb-6">
        <label class="relative cursor-pointer p-4 rounded-2xl border-2 border-amber-600 bg-amber-50/50 shadow-md flex items-center justify-between block">
          <span class="absolute -top-3 right-4 bg-amber-600 text-white text-xs font-bold uppercase px-2 py-0.5 rounded-full">
            Most Popular
          </span>
          <div class="flex items-center space-x-3">
            <input type="radio" name="tibella_pack" value="2-pack" checked class="w-5 h-5 accent-amber-600">
            <div>
              <div class="font-bold text-slate-900">2-Pack System (Home & Travel)</div>
              <div class="text-xs text-slate-500">$49.50 / unit</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xl font-black text-slate-900">$99</div>
            <span class="text-xs font-bold text-emerald-600">SAVE $19</span>
          </div>
        </label>
      </div>

      <button id="add-to-cart-btn" onclick="addTibellaToCart()" class="w-full py-4 bg-amber-600 hover:bg-amber-700 text-white text-lg font-bold rounded-2xl shadow-lg transition-transform active:scale-95">
        CLAIM YOUR 90-DAY RISK-FREE TRIAL ($99)
      </button>

      <div class="flex items-center justify-center space-x-4 mt-4 text-xs text-slate-500">
        <span>🔒 256-Bit SSL Encryption</span>
        <span>•</span>
        <span>🚚 Fast US Delivery</span>
      </div>
    </div>

  </main>
</div>

<script>
  function addTibellaToCart() {
    const btn = document.getElementById('add-to-cart-btn');
    btn.innerText = 'Redirecting to Checkout...';
    btn.disabled = true;

    const variantId = {{ massager.variants.first.id | default: 0 }};

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1
        }]
      })
    })
    .then(res => res.json())
    .then(data => {
      window.location.href = '/checkout';
    })
    .catch(err => {
      console.error('Cart add error:', err);
      btn.disabled = false;
      btn.innerText = 'CLAIM YOUR 90-DAY RISK-FREE TRIAL ($99)';
    });
  }
</script>

{% schema %}
{
  "name": "Tibella Longform Page",
  "settings": [],
  "presets": [
    {
      "name": "Tibella Longform Page"
    }
  ]
}
{% endschema %}