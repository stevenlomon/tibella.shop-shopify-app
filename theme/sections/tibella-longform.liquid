{% comment %}
  Tibella Long-Form Sales Page Section (V2 - Premium Brand Palette)
{% endcomment %}

<script src="https://cdn.tailwindcss.com"></script>

{% assign massager = all_products['ankle-support-ems-massager-with-remote-control'] %}

<!-- Base Background: Cream #F4EEE6, Main Text: Charcoal #18181A -->
<div class="min-h-screen bg-[#F4EEE6] py-8 font-sans text-[#18181A]">
  
  <!-- HERO HEADER (Light Beige #DDD0C2) -->
  <header class="w-full bg-[#DDD0C2] border-b border-[#D1AE5B]/30 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <span class="inline-block bg-[#18181A] text-[#F4EEE6] text-xs md:text-sm font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 shadow-sm">
        OVERACTIVE BLADDER & NOCTURIA BREAKTHROUGH
      </span>
      
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight mb-6">
        The "Ankle-to-Bladder" Signal: How 32,000+ Menopausal Women Are Quieting Misfiring Bladder Nerves from Home
      </h1>
      
      <p class="text-lg sm:text-xl text-[#666666] leading-relaxed mb-8 max-w-3xl">
        If you go from <span class="font-bold text-[#18181A]">"I don't have to pee"</span> to <span class="font-bold text-[#18181A]">"I'm peeing"</span> in about 12 seconds—or if your bladder completely gives up when you pull into your driveway—your bladder isn't broken. It's getting bad instructions from a misfiring nerve.
      </p>

      <!-- HERO IMAGE PLACEHOLDER -->
      <div class="w-full max-w-3xl mx-auto mb-8 rounded-2xl overflow-hidden shadow-xl border-4 border-[#F4EEE6]">
        <img src="https://cdn.shopify.com/s/files/1/0994/7971/6159/files/Gemini_Generated_Image_x1zzszx1zzszx1zz_1.png?v=1785343401" alt="Woman relaxing on couch using Tibella" class="w-full h-auto object-cover" />
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-left border-t border-[#666666]/20 pt-6 w-full max-w-3xl">
        <div class="flex items-center space-x-2">
          <span class="text-[#D1AE5B] font-bold text-lg">✓</span>
          <span class="text-sm font-medium text-[#18181A]">20+ Yrs Urology Science</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-[#D1AE5B] font-bold text-lg">✓</span>
          <span class="text-sm font-medium text-[#18181A]">100% Drug-Free & Safe</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-[#D1AE5B] font-bold text-lg">✓</span>
          <span class="text-sm font-medium text-[#18181A]">30 Min/Day Sessions</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-[#D1AE5B] font-bold text-lg">✓</span>
          <span class="text-sm font-medium text-[#18181A]">90-Day Risk-Free Trial</span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-12">
    
    <!-- BELIEF SHIFT #1 -->
    <section class="mb-12 p-8 bg-white rounded-3xl border border-[#DDD0C2] shadow-lg">
      <div class="text-xs font-bold uppercase tracking-widest text-[#D1AE5B] mb-2">
        Belief Shift #1
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold mb-6">
        The 'Latchkey Bladder' Trap Is Real (And It Isn't 'Just Aging')
      </h2>

      <blockquote class="p-5 mb-6 border-l-4 border-[#D1AE5B] bg-[#F4EEE6] rounded-r-xl italic text-[#18181A] text-lg">
        "I can hold it for 45 minutes... but the second I pull into my driveway, my bladder just completely gives up."
        <cite class="block font-semibold not-italic text-sm text-[#666666] mt-3">— Verified User Review</cite>
      </blockquote>
      <p class="text-[#666666] leading-relaxed mb-8">
        If you find yourself mapping every single public bathroom before leaving the house, you are not alone. Most doctors will tell you this is "just a normal part of aging." They are wrong. It is a misfiring nerve signal.
      </p>

      <!-- HOW IT WORKS IMAGE PLACEHOLDER -->
      <img src="https://cdn.shopify.com/s/files/1/0994/7971/6159/files/img4.png?v=1785343392" alt="How Tibella Works" class="w-full rounded-xl shadow-sm border border-[#DDD0C2]" />
    </section>

    <!-- COMPARISON SECTION -->
    <section class="mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8">A Smarter, Non-Invasive Way to Take Back Control</h2>
      <!-- COMPARISON IMAGE PLACEHOLDER -->
      <img src="https://cdn.shopify.com/s/files/1/0994/7971/6159/files/img6.png?v=1785343392" alt="Tibella vs Others" class="w-full rounded-3xl shadow-xl border border-[#DDD0C2]" />
    </section>

    <!-- DAY 1 VS DAY 30 IMAGE PLACEHOLDER -->
    <section class="mb-12">
      <img src="https://cdn.shopify.com/s/files/1/0994/7971/6159/files/img3.png?v=1785343393" alt="Day 1 vs Day 30 Results" class="w-full rounded-3xl shadow-lg border border-[#DDD0C2]" />
    </section>

    <!-- OFFER SELECTOR COMPONENT -->
    <div id="tibella-offer-root" class="max-w-xl mx-auto p-8 bg-white border-2 border-[#D1AE5B] rounded-3xl shadow-2xl mt-12 relative overflow-hidden">
      <!-- Decorative background accent -->
      <div class="absolute top-0 right-0 w-32 h-32 bg-[#D1AE5B] opacity-10 rounded-bl-full"></div>

      <div class="text-center mb-8 relative z-10">
        <h3 class="text-3xl font-extrabold text-[#18181A]">Select Your Package</h3>
        <p class="text-[#666666] mt-2 font-medium">Includes 90-Day Money-Back Guarantee + Free US Shipping</p>
      </div>

      <div class="space-y-4 mb-8 relative z-10">
        <!-- 2-Pack Selected by Default -->
        <label class="relative cursor-pointer p-5 rounded-2xl border-2 border-[#D1AE5B] bg-[#F4EEE6] shadow-md flex items-center justify-between block transition-all transform hover:scale-[1.02]">
          <span class="absolute -top-3 right-6 bg-[#18181A] text-[#D1AE5B] text-xs font-black uppercase px-3 py-1 rounded-full shadow-sm">
            Most Popular
          </span>
          <div class="flex items-center space-x-4">
            <input type="radio" name="tibella_pack" value="2-pack" checked class="w-6 h-6 accent-[#D1AE5B]">
            <div>
              <div class="font-bold text-lg text-[#18181A]">2-Pack System</div>
              <div class="text-sm text-[#666666]">Home & Travel ($49.50/unit)</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-2xl font-black text-[#18181A]">$99</div>
            <span class="text-xs font-bold text-[#D1AE5B] bg-[#18181A] px-2 py-0.5 rounded">SAVE $19</span>
          </div>
        </label>
      </div>

      <!-- GOLD BUTTON, CHARCOAL TEXT -->
      <button id="add-to-cart-btn" onclick="addTibellaToCart()" class="relative z-10 w-full py-5 bg-[#D1AE5B] hover:bg-[#c4a150] text-[#18181A] text-xl font-black rounded-2xl shadow-xl transition-transform active:scale-95">
        CLAIM 90-DAY RISK-FREE TRIAL ($99)
      </button>

      <div class="flex items-center justify-center space-x-6 mt-6 text-sm font-medium text-[#666666] relative z-10">
        <span class="flex items-center"><svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg> 256-Bit Secure</span>
        <span>•</span>
        <span class="flex items-center">🚚 Fast US Delivery</span>
      </div>
    </div>

  </main>
</div>

<script>
  function addTibellaToCart() {
    const btn = document.getElementById('add-to-cart-btn');
    btn.innerText = 'Securely Redirecting...';
    btn.disabled = true;

    const variantId = {{ massager.variants.first.id | default: 0 }};

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: variantId,
          quantity: 1
        }]
      })
    })
    .then(res => res.json())
    .then(data => {
      window.location.href = '/checkout';
    })
    .catch(err => {
      console.error('Cart add error:', err);
      btn.disabled = false;
      btn.innerText = 'CLAIM 90-DAY RISK-FREE TRIAL ($99)';
    });
  }
</script>

{% schema %}
{
  "name": "Tibella Longform Page",
  "settings": [],
  "presets": [
    {
      "name": "Tibella Longform Page"
    }
  ]
}
{% endschema %}