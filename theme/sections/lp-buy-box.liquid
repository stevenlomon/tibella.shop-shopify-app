                </div>
                <span class="bb-gift-price">{{ bb_gift_remote_value }}</span>
                <span class="bb-gift-name">FREE Remote</span>
              </div>
              <span class="bb-gift-plus">+</span>
              <div class="bb-gift locked" data-unlock="3">
                <div class="bb-gift-visual">
                  <img class="bb-gift-img" src="{{ bb_img_1x }}" alt="Tibella device">
                  <svg class="bb-gift-lock" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 11V7a4 4 0 018 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <span class="bb-gift-price">{{ bb_gift_device_value }}</span>
