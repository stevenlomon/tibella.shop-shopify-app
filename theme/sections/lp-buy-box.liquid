          <div class="bb-accordion">
            <button class="bb-accordion-trigger" onclick="bbToggle(this)">
              What's In The Box
              <svg viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="bb-accordion-body">
              <p>1x Tibella nerve stimulation device</p>
              <p>1x Wireless remote control</p>
              <p>1x USB charging cable</p>
              <p>1x Quick start guide</p>
            </div>
          </div>
          <div class="bb-accordion">
            <button class="bb-accordion-trigger" onclick="bbToggle(this)">
              Specifications
              <svg viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="bb-accordion-body">
              <p>Frequency: 20 Hz (optimized for tibial nerve stimulation)</p>
              <p>Pulse width: 200 microseconds</p>
              <p>Modes: 6 stimulation modes</p>
              <p>Intensity: 19 adjustable levels</p>
              <p>Session timer: Auto 30-minute shutoff</p>
              <p>Battery: Rechargeable lithium-ion (USB-C)</p>
              <p>Battery life: ~10 sessions per charge</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>


<script>
function bbSelectPack(el) {
  document.querySelectorAll('.bb-pack').forEach(function(p) { p.classList.remove('active'); });
  el.classList.add('active');
  var level = parseInt(el.dataset.level) || 1;
  document.querySelectorAll('.bb-gift').forEach(function(g) {
    var unlock = parseInt(g.dataset.unlock) || 1;
    g.classList.toggle('locked', level < unlock);
  });
}

function bbSelectImage(thumb, src) {
  document.querySelectorAll('.bb-thumb').forEach(function(t) { t.classList.remove('active'); });
  thumb.classList.add('active');
  var main = document.getElementById('bb-main-image');
  var img = main.querySelector('img');
  if (img) { img.src = src; }
}

function bbToggle(trigger) {
  trigger.closest('.bb-accordion').classList.toggle('open');
}

(function() {
  var wrap = document.getElementById('bb-shipping');
  if (!wrap) return;
  var days = parseInt(wrap.dataset.days) || 10;
  var d = new Date();
  var added = 0;
  while (added < days) {
    d.setDate(d.getDate() + 1);
    if (d.getDay() !== 0 && d.getDay() !== 6) added++;
  }
  var el = document.getElementById('bb-ship-date');
  if (el) el.textContent = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
})();

(function() {
  var form = document.getElementById('bb-product-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var activePack = document.querySelector('.bb-pack.active');
    if (!activePack) return;
    var items = JSON.parse(activePack.dataset.pack);
    var btn = form.querySelector('[type="submit"]');
    btn.setAttribute('aria-disabled', 'true');
    btn.textContent = 'Adding...';
    fetch('/cart/clear.js', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function() {
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ items: items })
      });
    })
    .then(function(r) { return r.json(); })
    .then(function(response) {
      if (response.status) { window.location.href = '/cart'; return; }
      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) {
        fetch('/?section_id=cart-drawer')
          .then(function(r) { return r.text(); })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newDrawer = doc.querySelector('cart-drawer');
            if (newDrawer) {
              cartDrawer.querySelector('.drawer__inner').innerHTML = newDrawer.querySelector('.drawer__inner').innerHTML;
              cartDrawer.classList.remove('is-empty');
            }
            var bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble');
            if (bubble) {
              fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
                bubble.querySelector('[aria-hidden]').textContent = cart.item_count;
                bubble.querySelector('.visually-hidden').textContent = cart.item_count + ' items';
              });
            }
            cartDrawer.open(btn);
          });
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(function() { window.location.href = '/cart'; })
    .finally(function() {
      btn.removeAttribute('aria-disabled');
      btn.textContent = 'Add To Cart';
    });
  });
})();
</script>


