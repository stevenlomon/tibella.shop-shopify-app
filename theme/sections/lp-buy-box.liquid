            </div>
          </div>

          <p class="bb-pack-note">{{ bb_pack_note }}</p>

          <button type="submit" class="bb-atc"{% unless v_device.available and v_bundle.available %} disabled{% endunless %}>
            {% if v_device.available and v_bundle.available %}{{ bb_cta }}{% else %}{{ bb_sold_out }}{% endif %}
