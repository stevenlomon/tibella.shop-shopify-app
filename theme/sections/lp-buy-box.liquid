{%- render 'lp-brand-vars' -%}
{%- assign product = section.settings.product | default: settings.lp_product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%} ═══ CONTENT CONFIG ═══ {%- endcomment -%}

{%- assign bb_description = "A home-use nerve stimulation device that targets the root cause of urgency, leaks, and nighttime bathroom trips. Just 30 minutes, a few times a week." -%}
{%- assign bb_free_ship = "Free Shipping" -%}
{%- assign bb_pack_label = "Select Quantity:" -%}
{%- assign bb_pack_note = "*For Best Results, Use Consistently For 4-6 Weeks" -%}
{%- assign bb_pack_badge_2 = "Most Popular" -%}
{%- assign bb_pack_badge_3 = "Best Value" -%}
{%- assign bb_cta = "Add To Cart" -%}
{%- assign bb_sold_out = "Sold Out" -%}
{%- assign bb_trust_1 = "60-Day Money-Back Guarantee" -%}
{%- assign bb_trust_2 = "Free US Shipping" -%}

{%- comment -%} ═══ END CONTENT CONFIG ═══ {%- endcomment -%}

<style>
/* ── Buy Box ── */
.bb {
  font-family: var(--font-body);
  padding: 55px 0 80px;
  border-top: 1px solid var(--border);
}
.bb-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 18px;
}
.bb-layout {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* ── Image ── */
.bb-media {
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}
.bb-media-main {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: var(--light);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bb-media-main img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.bb-thumbnails {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  overflow-x: auto;
  scrollbar-width: none;
}
.bb-thumbnails::-webkit-scrollbar { display: none; }
.bb-thumb {
  flex: 0 0 64px;
  width: 64px;
  height: 64px;
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  background: var(--light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bb-thumb.active { border-color: var(--brown); }
.bb-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Details ── */
.bb-details {}
.bb-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--body);
  margin-bottom: 16px;
}
.bb-badge-stars {
  color: var(--gold);
  font-size: 16px;
  letter-spacing: 1px;
}
.bb-badge-rating {
  font-weight: 700;
  color: var(--heading);
}
.bb-badge-count {
  color: var(--muted);
}
.bb-desc {
  font-size: 16px;
  color: var(--heading);
  line-height: 1.6;
  margin-bottom: 24px;
}
.bb-benefits {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 28px;
}
.bb-benefit {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  color: var(--heading);
  line-height: 1.4;
}
.bb-check {
  width: 22px;
  height: 22px;
  min-width: 22px;
  background: var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bb-check svg { width: 12px; height: 12px; }

/* ── Price ── */
.bb-price-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 28px;
}
.bb-price {
  font-size: 32px;
  font-weight: 700;
  color: var(--heading);
}
.bb-free-ship {
  font-size: 15px;
  font-weight: 700;
  color: var(--green);
}

/* ── Pack Selector ── */
.bb-pack-label {
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 14px;
}
.bb-packs {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  margin-bottom: 12px;
}
.bb-pack {
  position: relative;
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.2s;
  background: var(--white);
}
.bb-pack:hover { border-color: var(--brown); }
.bb-pack.active { border-color: var(--brown); }
.bb-pack-badge {
  position: absolute;
  top: -11px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--green);
  color: var(--white);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 4px;
  white-space: nowrap;
}
.bb-pack-badge--gold {
  background: var(--gold);
}
.bb-pack-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 4px;
}
.bb-pack-price {
  font-size: 14px;
  color: var(--body);
}
.bb-pack-save {
  font-size: 12px;
  font-weight: 700;
  color: var(--green);
  text-transform: uppercase;
  margin-top: 4px;
}
.bb-pack-note {
  font-size: 13px;
  font-weight: 700;
  color: var(--body);
  text-align: center;
  margin-bottom: 20px;
}

/* ── Add to Cart ── */
.bb-atc {
  display: block;
  width: 100%;
  padding: 18px 32px;
  background: var(--brown);
  color: var(--white);
  border: none;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.2s;
  text-align: center;
}
.bb-atc:hover { background: var(--brown-hover); }
.bb-atc:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ── Trust ── */
.bb-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 16px;
  font-size: 13px;
  color: var(--body);
}
.bb-trust-item {
  display: flex;
  align-items: center;
  gap: 6px;
}
.bb-trust-icon {
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Accordions ── */
.bb-accordions {
  margin-top: 28px;
  border-top: 1px solid var(--border);
}
.bb-accordion {
  border-bottom: 1px solid var(--border);
}
.bb-accordion-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
  background: none;
  border: none;
  font-family: var(--font);
  font-size: 16px;
  font-weight: 700;
  color: var(--heading);
  cursor: pointer;
  text-align: left;
}
.bb-accordion-trigger svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  transition: transform 0.2s;
  color: var(--body);
}
.bb-accordion.open .bb-accordion-trigger svg {
  transform: rotate(90deg);
}
.bb-accordion-body {
  display: none;
  padding: 0 0 18px;
  font-size: 15px;
  color: var(--body);
  line-height: 1.6;
}
.bb-accordion.open .bb-accordion-body {
  display: block;
}

/* ── Desktop ── */
@media (min-width: 768px) {
  .bb-layout {
    flex-direction: row;
    gap: 48px;
    align-items: flex-start;
  }
  .bb-media {
    flex: 0 0 48%;
    max-width: none;
    position: sticky;
    top: 100px;
  }
  .bb-details { flex: 1; }
  .bb-packs { grid-template-columns: repeat(3, 1fr); gap: 12px; }
}

@media (min-width: 1024px) {
  .bb-inner { padding: 0 40px; }
  .bb-media { flex: 0 0 50%; }
}
</style>


<section class="bb" id="pdp">
  <div class="bb-inner">
    <div class="bb-layout">

      <!-- IMAGE -->
      <div class="bb-media">
        <div class="bb-media-main" id="bb-main-image">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="800" loading="lazy">
          {% else %}
            <span style="font-size:13px;color:#8A8787;font-weight:700;letter-spacing:1px;text-transform:uppercase;">Product Image</span>
          {% endif %}
        </div>
        {% if product.media.size > 1 %}
          <div class="bb-thumbnails">
            {% for media in product.media %}
              <div class="bb-thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" onclick="bbSelectImage(this, '{{ media | image_url: width: 800 }}')">
                <img src="{{ media | image_url: width: 128 }}" alt="{{ media.alt | escape }}" width="64" height="64" loading="lazy">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- DETAILS -->
      <div class="bb-details">
        <div class="bb-badge">
          <span class="bb-badge-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="bb-badge-rating">{{ settings.lp_trust_rating }}</span>
          <span class="bb-badge-count">{{ settings.lp_trust_text }}</span>
        </div>

        <p class="bb-desc">{{ bb_description }}</p>

        {%- comment -%} ═══ BENEFITS — edit bullets directly ═══ {%- endcomment -%}
        <div class="bb-benefits">
          <div class="bb-benefit">
            <span class="bb-check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            6 stimulation modes, 19 intensity levels
          </div>
          <div class="bb-benefit">
            <span class="bb-check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            30-minute sessions, 3-4 times per week
          </div>
          <div class="bb-benefit">
            <span class="bb-check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            USB rechargeable with remote control
          </div>
          <div class="bb-benefit">
            <span class="bb-check"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            Gentle tingling, you control the intensity
          </div>
        </div>

        <div class="bb-price-row">
          <span class="bb-price" id="bb-display-price">${{ current_variant.price | money_without_currency }}</span>
          <span class="bb-free-ship">{{ bb_free_ship }}</span>
        </div>

        {% form 'product', product, id: 'bb-product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="bb-variant-id">

          <div class="bb-pack-label">{{ bb_pack_label }}</div>
          <div class="bb-packs" id="bb-packs">
            {% for variant in product.variants %}
              <div class="bb-pack{% if forloop.first %} active{% endif %}"
                   data-variant-id="{{ variant.id }}"
                   data-price="{{ variant.price | money_without_currency }}"
                   onclick="bbSelectPack(this)">
                {% if forloop.index == 2 and bb_pack_badge_2 != blank %}
                  <div class="bb-pack-badge">{{ bb_pack_badge_2 }}</div>
                {% elsif forloop.index == 3 and bb_pack_badge_3 != blank %}
                  <div class="bb-pack-badge bb-pack-badge--gold">{{ bb_pack_badge_3 }}</div>
                {% endif %}
                <div class="bb-pack-name">{{ variant.title }}</div>
                <div class="bb-pack-price">${{ variant.price | money_without_currency }}</div>
                {% unless forloop.first %}
                  {% assign single_price = product.variants.first.price %}
                  {% assign pack_count = forloop.index %}
                  {% assign full_price = single_price | times: pack_count %}
                  {% assign saved = full_price | minus: variant.price %}
                  {% assign pct = saved | times: 100 | divided_by: full_price %}
                  {% if pct > 0 %}
                    <div class="bb-pack-save">Save {{ pct }}%</div>
                  {% endif %}
                {% endunless %}
              </div>
            {% endfor %}
          </div>

          <p class="bb-pack-note">{{ bb_pack_note }}</p>

          <button type="submit" class="bb-atc"{% unless current_variant.available %} disabled{% endunless %}>
            {% if current_variant.available %}{{ bb_cta }}{% else %}{{ bb_sold_out }}{% endif %}
          </button>
        {% endform %}

        <div class="bb-trust">
          <span class="bb-trust-item">
            <span class="bb-trust-icon"><svg viewBox="0 0 16 16" fill="none"><path d="M8 1l2 4h4l-3 3 1 4-4-2-4 2 1-4-3-3h4z" fill="#E8A838"/></svg></span>
            {{ bb_trust_1 }}
          </span>
          <span class="bb-trust-item">
            <span class="bb-trust-icon"><svg viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" fill="#3D8C52"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            {{ bb_trust_2 }}
          </span>
        </div>

        {%- comment -%} ═══ ACCORDIONS — edit sections directly ═══ {%- endcomment -%}
        <div class="bb-accordions">
          <div class="bb-accordion">
            <button class="bb-accordion-trigger" onclick="bbToggle(this)">
              How To Use
              <svg viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="bb-accordion-body">
              <p>1. Place Tibella around your inner ankle bone and secure with the adjustable strap.</p>
              <p>2. Use the remote control to select your preferred mode and intensity level.</p>
              <p>3. Relax for 30 minutes while Tibella stimulates the posterior tibial nerve.</p>
              <p>Use 3-4 times per week for best results. Most women notice improvement within 4-6 weeks.</p>
            </div>
          </div>
          <div class="bb-accordion">
            <button class="bb-accordion-trigger" onclick="bbToggle(this)">
              What's In The Box
              <svg viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="bb-accordion-body">
              <p>1x Tibella nerve stimulation device</p>
              <p>1x Wireless remote control</p>
              <p>1x USB charging cable</p>
              <p>1x Quick start guide</p>
            </div>
          </div>
          <div class="bb-accordion">
            <button class="bb-accordion-trigger" onclick="bbToggle(this)">
              Specifications
              <svg viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="bb-accordion-body">
              <p>Frequency: 20 Hz (optimized for tibial nerve stimulation)</p>
              <p>Pulse width: 200 microseconds</p>
              <p>Modes: 6 stimulation modes</p>
              <p>Intensity: 19 adjustable levels</p>
              <p>Session timer: Auto 30-minute shutoff</p>
              <p>Battery: Rechargeable lithium-ion (USB-C)</p>
              <p>Battery life: ~10 sessions per charge</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>


<script>
function bbSelectPack(el) {
  document.querySelectorAll('.bb-pack').forEach(function(p) { p.classList.remove('active'); });
  el.classList.add('active');
  var variantId = el.dataset.variantId;
  var price = el.dataset.price;
  document.getElementById('bb-variant-id').value = variantId;
  document.getElementById('bb-display-price').textContent = '$' + price;
}

function bbSelectImage(thumb, src) {
  document.querySelectorAll('.bb-thumb').forEach(function(t) { t.classList.remove('active'); });
  thumb.classList.add('active');
  var main = document.getElementById('bb-main-image');
  var img = main.querySelector('img');
  if (img) { img.src = src; }
}

function bbToggle(trigger) {
  trigger.closest('.bb-accordion').classList.toggle('open');
}

(function() {
  var form = document.getElementById('bb-product-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('[type="submit"]');
    btn.setAttribute('aria-disabled', 'true');
    btn.textContent = 'Adding...';
    var formData = new FormData(form);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(response) {
      if (response.status) { window.location.href = '/cart'; return; }
      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) {
        fetch('/?section_id=cart-drawer')
          .then(function(r) { return r.text(); })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newDrawer = doc.querySelector('cart-drawer');
            if (newDrawer) {
              cartDrawer.querySelector('.drawer__inner').innerHTML = newDrawer.querySelector('.drawer__inner').innerHTML;
              cartDrawer.classList.remove('is-empty');
            }
            var bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble');
            if (bubble) {
              fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
                bubble.querySelector('[aria-hidden]').textContent = cart.item_count;
                bubble.querySelector('.visually-hidden').textContent = cart.item_count + ' items';
              });
            }
            cartDrawer.open(btn);
          });
      } else {
        window.location.href = '/cart';
      }
    })
    .catch(function() { window.location.href = '/cart'; })
    .finally(function() {
      btn.removeAttribute('aria-disabled');
      btn.textContent = 'Add To Cart';
    });
  });
})();
</script>


{% schema %}
{
  "name": "LP Buy Box",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Overrides the global LP product for this section."
    }
  ]
}
{% endschema %}
