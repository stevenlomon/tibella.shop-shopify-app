<style>
:root {
  --nav-dark: #423F3F;
  --brown: #361E12;
  --brown-hover: #2A1610;
  --heading: #1B1919;
  --body-dark: #282828;
  --body: #5E5C5C;
  --muted: #8A8787;
  --cream: #F4F0E9;
  --cream-27: rgba(244, 240, 233, 0.27);
  --tan: #DBCCB9;
  --light: #F6F6F6;
  --white: #FFFFFF;
  --border: #E5E0D9;
  --green: #3D8C52;
  --red: #B54A3A;
  --gold: #E8A838;
  --font: "Century Gothic", "CenturyGothic", "AppleGothic", "Futura", "Avenir Next", system-ui, sans-serif;
}

/* ── Section Shared ── */
.section-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 18px;
}
.section-heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--heading);
  text-align: center;
  line-height: 1.2;
  text-wrap: balance;
}

/* ── Reviews ── */
.reviews-section {
  padding: 55px 0;
  border-top: 1px solid var(--border);
}
.review-cards {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-inline-start: 18px;
  padding: 30px 0 10px 18px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.review-cards::-webkit-scrollbar { display: none; }
.review-card {
  flex: 0 0 300px;
  scroll-snap-align: start;
  background: var(--cream);
  border-radius: 12px;
  padding: 22px 18px;
}
.review-card:last-child {
  margin-right: 18px;
}
.review-stars {
  color: var(--gold);
  font-size: 16px;
  letter-spacing: 2px;
  margin-bottom: 14px;
}
.review-title {
  font-size: 18px;
  font-weight: 700;
  color: rgb(33, 33, 33);
  margin-bottom: 12px;
}
.review-body {
  font-size: 15px;
  color: rgb(33, 33, 33);
  line-height: 1.6;
  margin-bottom: 18px;
}
.review-name {
  font-size: 15px;
  font-weight: 700;
  color: rgb(33, 33, 33);
}
.review-verified {
  font-size: 15px;
  color: rgb(71, 71, 71);
  margin-top: 2px;
}
.review-sample-note {
  text-align: center;
  font-size: 12px;
  color: var(--muted);
  margin-top: 14px;
  font-style: italic;
}

/* ── Carousel ── */
.review-carousel {
  position: relative;
}
.carousel-arrow {
  display: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 40px;
  height: 40px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 24px;
  line-height: 1;
  color: var(--heading);
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: opacity 0.2s;
  align-items: center;
  justify-content: center;
  padding: 0 0 2px;
}
.carousel-prev { left: 6px; }
.carousel-next { right: 6px; }
.carousel-arrow:disabled {
  opacity: 0;
  pointer-events: none;
}
.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 18px 18px 0;
}
.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--border);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s;
}
.carousel-dot.active {
  background: var(--brown);
}

/* ── Guarantee ── */
.guarantee-section {
  padding: 55px 0;
  background: var(--light);
}
.guarantee-card {
  background: var(--brown);
  border-radius: 16px;
  padding: 40px 24px;
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}
.guarantee-heading {
  font-size: 22px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.3;
  margin-bottom: 18px;
  text-wrap: balance;
}
.guarantee-body {
  font-size: 14px;
  color: var(--white);
  line-height: 1.7;
  margin-bottom: 28px;
  opacity: 0.9;
}
.guarantee-body strong {
  font-weight: 700;
  opacity: 1;
}
.btn-guarantee {
  display: inline-block;
  padding: 14px 40px;
  background: var(--white);
  color: rgb(8, 8, 8);
  border: none;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.5px;
  transition: background 0.2s;
  text-decoration: none;
}
.btn-guarantee:hover { background: var(--cream); }

/* ── FAQ ── */
.faq-section {
  padding: 55px 0;
}
.faq-list {
  max-width: 680px;
  margin: 30px auto 0;
}
.faq-item {
  border-bottom: 1px solid var(--border);
}
.faq-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
  background: none;
  border: none;
  font-family: var(--font);
  font-size: 16px;
  font-weight: 700;
  color: #000;
  cursor: pointer;
  text-align: left;
  gap: 16px;
}
.faq-trigger svg {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  transition: transform 0.2s;
}
.faq-item.open .faq-trigger svg {
  transform: rotate(45deg);
}
.faq-answer {
  display: none;
  padding: 0 0 18px;
  font-size: 15px;
  color: var(--body);
  line-height: 1.6;
}
.faq-item.open .faq-answer {
  display: block;
}

/* ── Sticky Cart ── */
.sticky-cart {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: var(--white);
  border-top: 1px solid var(--border);
  padding: 10px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 999999;
  box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  transform: translateY(100%);
  transition: transform 0.3s ease-in-out;
  visibility: hidden;
}
.sticky-cart.visible {
  transform: translateY(0);
  visibility: visible;
}
.sticky-cart-info {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.sticky-cart-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--heading);
}
.sticky-cart-price {
  font-size: 14px;
  color: var(--body);
}
.sticky-cart-price strong {
  color: var(--heading);
  font-weight: 700;
}
.btn-sticky {
  background: var(--brown);
  color: var(--white);
  font-family: var(--font);
  font-size: 14px;
  font-weight: 700;
  padding: 12px 28px;
  border-radius: 50px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s;
}
.btn-sticky:hover { background: var(--brown-hover); }

/* ── Desktop ── */
@media (min-width: 768px) {
  .review-carousel { max-width: 1100px; margin: 0 auto; }
  .review-cards { padding: 30px 18px 10px; scroll-padding-inline-start: 18px; }
  .review-card { flex: 0 0 320px; }
  .review-card:last-child { margin-right: 0; }
  .carousel-arrow { display: flex; }
  .guarantee-heading { font-size: 24px; }
}

@media (min-width: 1024px) {
  .section-inner { padding: 0 40px; }
}
</style>


