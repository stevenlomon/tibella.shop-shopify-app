{% assign product = all_products['ankle-support-ems-massager-with-remote-control'] %}

<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tibella - Drug-Free Bladder Control Device</title>
<style>
:root {
  --nav-dark: #423F3F;
  --brown: #361E12;
  --brown-hover: #2A1610;
  --heading: #1B1919;
  --body-dark: #282828;
  --body: #5E5C5C;
  --muted: #8A8787;
  --cream: #F4F0E9;
  --cream-27: rgba(244, 240, 233, 0.27);
  --tan: #DBCCB9;
  --light: #F6F6F6;
  --white: #FFFFFF;
  --border: #E5E0D9;
  --green: #3D8C52;
  --red: #B54A3A;
  --gold: #E8A838;
  --font: "Century Gothic", "CenturyGothic", "AppleGothic", "Futura", "Avenir Next", system-ui, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font);
  color: var(--body-dark);
  background: var(--white);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


/* ── Hero ── */
.hero {
  text-align: center;
  padding: 45px 18px 50px;
}
.hero-split {
  max-width: 1200px;
  margin: 0 auto;
}
.hero-copy {}
.hero-trust {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 18px;
}
.hero-stars {
  color: var(--gold);
  font-size: 14px;
  letter-spacing: 1px;
}
.hero-trust-text {
  font-size: 14px;
  color: #000;
}
.hero-headline {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.2;
  color: #000;
  margin-bottom: 28px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  text-wrap: balance;
}
.hero-body-wrap {
  margin-bottom: 28px;
}
.hero-dash {
  display: none;
}
.hero-image-wrap {
  position: relative;
  margin: 0 auto 24px;
  max-width: 400px;
}
.btn-primary.hero-btn {
  margin-top: 8px;
}
.hero-product-img {
  width: 100%;
  position: relative;
  overflow: hidden;
}
.hero-callout {
  position: absolute;
  background: var(--white);
  border-radius: 10px;
  padding: 10px 14px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--heading);
  white-space: nowrap;
}
.hero-callout svg { flex-shrink: 0; }
.callout-mid-left { top: 30%; left: -8px; }
.callout-mid-right { top: 30%; right: -8px; }
.callout-bottom-left { bottom: 10%; left: -8px; }
.hero-body {
  font-size: 16px;
  line-height: 1.6;
  color: #000;
  max-width: 520px;
  margin: 0 auto;
}
.btn-primary {
  display: block;
  width: 100%;
  max-width: 400px;
  margin: 0 auto;
  padding: 16px 32px;
  background: var(--brown);
  color: var(--white);
  border: none;
  border-radius: 6px;
  font-family: var(--font);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.2s;
  text-align: center;
  text-decoration: none;
}
.btn-primary:hover { background: var(--brown-hover); }

/* ── Trust Strip ── */
.trust-strip {
  background: rgb(25, 13, 6);
  padding: 14px 0;
  overflow: hidden;
  white-space: nowrap;
}
.trust-strip-inner {
  display: inline-flex;
  animation: marquee 25s linear infinite;
}
.trust-strip-item {
  font-size: 14px;
  font-weight: 700;
  color: var(--white);
  padding: 0 28px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.trust-strip-item::before {
  content: '';
  width: 6px;
  height: 6px;
  background: var(--tan);
  border-radius: 50%;
  flex-shrink: 0;
}
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ── Section Shared ── */
.section-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 18px;
}
.section-heading {
  font-size: 28px;
  font-weight: 700;
  color: var(--heading);
  text-align: center;
  line-height: 1.2;
  text-wrap: balance;
}

/* ── Problem Section ── */
.problem-section {
  padding: 55px 0 0;
}
.problem-layout {
  margin-top: 35px;
}
.problem-img {
  width: 100%;
  aspect-ratio: 4 / 5;
  background: linear-gradient(145deg, #f8f5f0 0%, #ebe5db 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  max-width: 360px;
  margin-left: auto;
  margin-right: auto;
}
.problem-card {
  background: var(--cream);
  border-radius: 12px;
  padding: 30px 18px;
}
.stat-row {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-bottom: 24px;
}
.stat-donut {
  flex-shrink: 0;
  position: relative;
  width: 110px;
  height: 110px;
}
.stat-donut svg { width: 110px; height: 110px; }
.stat-donut-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  color: var(--heading);
}
.stat-heading {
  font-size: 18px;
  font-weight: 700;
  color: var(--heading);
  line-height: 1.3;
}
.problem-explanations {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.problem-exp {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.problem-exp-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  background: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.problem-exp-icon svg { width: 16px; height: 16px; }
.problem-exp-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 4px;
}
.problem-exp-text {
  font-size: 14px;
  color: var(--body);
  line-height: 1.5;
}
.problem-note {
  background: var(--cream);
  border-radius: 12px;
  padding: 22px 18px;
  margin-top: 24px;
}
.problem-note p {
  font-size: 15px;
  color: var(--body);
  line-height: 1.6;
}
.problem-note strong {
  color: var(--heading);
}

/* ── Mechanism Section ── */
.mechanism-section {
  padding: 55px 0;
  background: var(--light);
}
.mech-eyebrow {
  text-transform: uppercase;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--brown);
  text-align: center;
  margin-bottom: 14px;
}
.mech-blocks {
  margin-top: 45px;
  display: flex;
  flex-direction: column;
  gap: 50px;
}
.mech-block {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.mech-img {
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
}
.mech-img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
}
.mech-text {}
.mech-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--heading);
  line-height: 1.25;
  margin-bottom: 14px;
  text-align: center;
  text-wrap: balance;
}
.mech-body {
  font-size: 16px;
  color: var(--body);
  line-height: 1.65;
}
.mech-detail {
  margin-top: 16px;
  padding: 16px 18px;
  background: var(--cream);
  border-radius: 10px;
  font-size: 14px;
  color: var(--body);
  line-height: 1.55;
}
.mech-detail strong {
  color: var(--heading);
}

/* ── Solution Section ── */
.solution-section {
  background: var(--tan);
  padding: 55px 0;
  margin-top: 55px;
}
.solution-split {
  max-width: 1200px;
  margin: 0 auto;
}
.solution-copy {}
.solution-eyebrow {
  text-transform: uppercase;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--brown);
  margin-bottom: 14px;
}
.solution-section .section-heading {
  text-align: left;
}
.solution-subhead {
  font-size: 17px;
  font-weight: 400;
  color: rgb(20, 10, 0);
  margin-top: 16px;
  line-height: 1.5;
}
.solution-benefits {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.solution-benefit {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.solution-check {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  background: var(--brown);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 1px;
}
.solution-check svg { width: 14px; height: 14px; }
.solution-benefit-text {
  font-size: 16px;
  color: var(--body-dark);
  line-height: 1.5;
}
.solution-img {
  width: 100%;
  max-width: 420px;
  margin: 30px auto 0;
}
.solution-img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16px;
}

/* ── Comparison Section ── */
.compare-section {
  padding: 55px 0;
  background: var(--light);
}
.compare-layout {
  margin-top: 40px;
}
.compare-note {
  margin-top: 20px;
  font-size: 13px;
  color: var(--muted);
  text-align: center;
  line-height: 1.5;
}
.compare-wrap {
  border-radius: 12px;
  overflow: hidden;
}
.compare-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.compare-table thead th {
  padding: 10px 6px;
  font-size: 11px;
  font-weight: 700;
  color: var(--body);
  text-align: center;
  background: var(--cream);
  border-bottom: 2px solid var(--border);
}
.compare-table thead th:first-child {
  text-align: left;
  background: transparent;
  color: var(--muted);
  font-weight: 400;
}
.compare-table thead th.col-highlight {
  background: var(--brown);
  color: var(--white);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  border-radius: 12px 12px 0 0;
}
.compare-table tbody td {
  padding: 10px 6px;
  text-align: center;
  border-bottom: 1px solid var(--border);
  color: var(--body);
  line-height: 1.3;
}
.compare-table tbody td:first-child {
  text-align: left;
  font-weight: 700;
  color: var(--heading);
  font-size: 12px;
}
.compare-table tbody tr:nth-child(even) td:first-child {
  background: var(--cream-27);
}
.compare-table tbody td.col-highlight {
  background: var(--brown);
  color: var(--white);
  border-bottom-color: rgba(255,255,255,0.1);
}
.compare-table tbody td.col-highlight .cmp-check {
  background: var(--gold);
}
.compare-table tbody tr:last-child td { border-bottom: none; }
.compare-table tbody tr:last-child td.col-highlight { border-radius: 0 0 12px 12px; }
.cmp-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  min-width: 20px;
  border-radius: 50%;
  background: var(--green);
}
.cmp-check svg { width: 11px; height: 11px; }
.cmp-x {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  min-width: 20px;
  border-radius: 50%;
  background: #f0e6e4;
}
.cmp-x svg { width: 10px; height: 10px; }
.cmp-warn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  min-width: 20px;
  border-radius: 50%;
  background: #faf0db;
}
.cmp-warn svg { width: 10px; height: 10px; }

/* ── How It Works ── */
.how-section {
  padding: 55px 0;
}
.how-cards {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 30px 18px 10px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.how-cards::-webkit-scrollbar { display: none; }
.how-card {
  flex: 0 0 280px;
  scroll-snap-align: start;
  background: var(--cream-27);
  border-radius: 12px;
  padding: 24px 18px;
  border: 1px solid var(--border);
}
.how-card-step {
  font-size: 12px;
  font-weight: 700;
  color: var(--brown);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}
.how-card-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 12px;
}
.how-card-text {
  font-size: 15px;
  color: var(--body);
  line-height: 1.6;
}

/* ── Mid-Page CTA ── */
.midcta-section {
  background: var(--brown);
  padding: 50px 0;
  text-align: center;
}
.midcta-inner {
  max-width: 600px;
  margin: 0 auto;
  padding: 0 18px;
}
.midcta-heading {
  font-size: 22px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.35;
  margin-bottom: 8px;
}
.midcta-sub {
  font-size: 15px;
  color: var(--tan);
  line-height: 1.5;
  margin-bottom: 24px;
}
.btn-midcta {
  display: inline-block;
  background: var(--white);
  color: var(--brown);
  font-family: var(--font);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 16px 40px;
  border-radius: 50px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background 0.2s;
}
.btn-midcta:hover { background: var(--cream); }
.midcta-badges {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 16px;
  font-size: 13px;
  color: var(--tan);
}
.midcta-badges svg {
  width: 14px;
  height: 14px;
  vertical-align: -2px;
  margin-right: 4px;
}

/* ── Clinical Stats ── */
.stats-section {
  background: var(--heading);
  padding: 55px 0;
  text-align: center;
}
.stats-heading {
  font-size: 22px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.35;
  margin-bottom: 6px;
}
.stats-sub {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  padding-bottom: 44px;
}
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  max-width: 520px;
  margin: 0 auto;
  padding: 0 18px;
}
.stat-card {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 24px 14px;
}
.stat-number {
  font-size: 38px;
  font-weight: 700;
  color: var(--white);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-label {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.45;
}
.stat-source {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4px;
}
.stats-note {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 30px;
  padding: 0 18px;
  line-height: 1.5;
}

/* ── How to Use (Physical) ── */
.use-section {
  padding: 0;
}
.use-full-img {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 18px;
}
.use-full-img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
}
.use-steps {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin-top: 35px;
}
.use-step {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
.use-step-num {
  flex: 0 0 44px;
  height: 44px;
  background: var(--brown);
  color: var(--white);
  font-size: 18px;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.use-step-content { flex: 1; }
.use-step-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--heading);
  margin-bottom: 4px;
}
.use-step-text {
  font-size: 15px;
  color: var(--body);
  line-height: 1.55;
}
.use-img {
  width: 100%;
  max-width: 400px;
  margin: 30px auto 0;
  aspect-ratio: 4 / 3;
  background: linear-gradient(145deg, #f8f5f0 0%, #ebe5db 100%);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Expert Credibility ── */
.expert-section {
  padding: 50px 0;
  background: var(--light);
}
.expert-card {
  background: var(--white);
  border-radius: 16px;
  padding: 30px 22px;
  text-align: center;
  max-width: 580px;
  margin: 0 auto;
  border: 1px solid var(--border);
}
.expert-badge {
  display: inline-block;
  background: var(--cream);
  color: var(--brown);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 50px;
  margin-bottom: 20px;
}
.expert-quote {
  font-size: 17px;
  color: var(--heading);
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 16px;
}
.expert-source {
  font-size: 13px;
  font-weight: 700;
  color: var(--brown);
  letter-spacing: 0.5px;
}
.expert-context {
  font-size: 13px;
  color: var(--muted);
  margin-top: 4px;
  line-height: 1.5;
}

/* ── Placeholder ── */
.placeholder-label {
  font-size: 13px;
  color: var(--muted);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ── Mobile Only ── */
.how-section { display: none; }
.use-img { display: none; }
.use-full-img { display: none; }
.use-section { padding: 55px 0; }
.expert-card { display: none; }

.solution-split {
  display: flex;
  flex-direction: column;
}
.solution-img { display: none; }
.solution-section .section-heading { text-align: center; }
.solution-copy { padding: 0 18px 20px; }

.use-steps {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 10px;
}
.use-steps::-webkit-scrollbar { display: none; }
.use-step {
  flex: 0 0 280px;
  scroll-snap-align: start;
  flex-direction: column;
  gap: 0;
  background: var(--cream-27);
  border-radius: 12px;
  padding: 24px 18px;
  border: 1px solid var(--border);
}
.use-step-num { width: 44px !important; min-width: 44px; max-width: 44px; height: 44px !important; margin-bottom: 12px; }
.use-step { align-items: flex-start; }
.use-step-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: linear-gradient(145deg, #f8f5f0 0%, #ebe5db 100%);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.stats-grid {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  max-width: none;
  padding: 0 18px;
}
.stats-grid::-webkit-scrollbar { display: none; }
.stat-card {
  flex: 0 0 260px;
  scroll-snap-align: start;
}

.expert-mobile-logo {
  text-align: center;
  max-width: 580px;
  margin: 0 auto;
  padding: 0 18px;
}
.expert-mobile-aua {
  width: 200px;
  height: 70px;
  margin: 0 auto 14px;
  background: var(--white);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
}
.expert-mobile-text {
  font-size: 14px;
  color: var(--body);
  line-height: 1.5;
}

/* ── Desktop ── */
@media (min-width: 768px) {
  .hero { padding: 60px 40px 60px; text-align: left; }
  .hero-split {
    display: grid;
    grid-template-columns: 48% 1fr;
    gap: 40px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-headline {
    font-size: 40px;
    line-height: 48px;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
  }
  .hero-body-wrap {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
  }
  .hero-dash {
    display: block;
    width: 40px;
    min-width: 40px;
    height: 2px;
    background: var(--brown);
