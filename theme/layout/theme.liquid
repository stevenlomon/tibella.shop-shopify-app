<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <!-- Tibella Global Theme Hijack Override -->
    <style>
      :root {
        /* Primary Backgrounds */
        --color-background: 244, 238, 230 !important; /* #F4EEE6 (Lightest Sand) */
        --color-background-secondary: 221, 208, 194 !important; /* #DDD0C2 (Warm Sand) */

        /* Text & Foregrounds */
        --color-foreground: 24, 24, 26 !important; /* #18181A (Dark Navy/Black) */
        --color-text: 24, 24, 26 !important;
        --color-body-text: 102, 102, 102 !important; /* #666666 (Muted Gray) */

        /* Brand Buttons & Gold Accents */
        --color-button: 209, 174, 91 !important; /* #D1AE5B (Gold) */
        --color-button-text: 24, 24, 26 !important; /* #18181A */
        --color-accent-1: 209, 174, 91 !important;
        --color-accent-2: 244, 238, 230 !important;

        /* Global Font Override */
        --font-body--family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        --font-heading--family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }

      /* Force Global Backgrounds & Header Styling */
      body, 
      .gradient, 
      .header-wrapper, 
      .footer {
        background-color: #F4EEE6 !important;
        color: #18181A !important;
      }

      /* Force Primary Buttons to Tibella Gold */
      .button,
      .button--primary,
      button[type="submit"] {
        background-color: #D1AE5B !important;
        color: #18181A !important;
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        font-weight: 800 !important;
        border-radius: 0.75rem !important;
        border: none !important;
      }

      .button:hover,
      .button--primary:hover {
        background-color: #c4a150 !important;
      }

      /* Policy Pages */
      .shopify-policy__container {
        max-width: 680px !important;
        margin: 0 auto !important;
        padding: 60px 18px 80px !important;
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .shopify-policy__title h1 {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        font-size: 32px !important;
        font-weight: 700 !important;
        color: #1B1919 !important;
        text-align: center !important;
        line-height: 1.2 !important;
        margin-bottom: 40px !important;
        letter-spacing: normal !important;
        text-transform: none !important;
      }
      .shopify-policy__body {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        font-size: 15px !important;
        color: #5E5C5C !important;
        line-height: 1.7 !important;
      }
      .shopify-policy__body h2,
      .shopify-policy__body h3 {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        color: #1B1919 !important;
        font-weight: 700 !important;
        margin-top: 32px !important;
      }
      .shopify-policy__body a {
        color: #361E12 !important;
        font-weight: 700 !important;
      }

      /* Cart Page & Cart Drawer */
      :root {
        --cart-primary-font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        --cart-secondary-font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .cart-page,
      .cart-drawer__content,
      .cart-drawer__inner,
      cart-drawer-component {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .cart-page .cart-title,
      .cart-page--empty .cart-title,
      .cart-page h1, .cart-page h2, .cart-page h3,
      .theme-drawer__title {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
        color: #1B1919 !important;
      }
      .cart-primary-typography,
      .cart-secondary-typography {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .cart-totals,
      .cart-totals__original-label,
      .cart-totals__original-value,
      .cart-totals__total-label,
      .cart-totals__total-value,
      .cart-discounts__label,
      .cart-discounts__value {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .cart-product__name,
      .cart-product__variant,
      .cart-product__price {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .cart-product__name {
        color: #1B1919 !important;
      }
      .cart-product__variant,
      .cart-product__price {
        color: #5E5C5C !important;
      }
      .cart-note__label,
      .cart-note__textarea,
      .cart-discount__label,
      .cart-discount__input {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
      .product-list h2, .product-list h3,
      .product-list .product-card__title,
      .product-list .product-card__price,
      product-price, product-price div, product-price .price,
      .h6 {
        font-family: "Century Gothic", CenturyGothic, AppleGothic, Futura, "Avenir Next", system-ui, sans-serif !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
